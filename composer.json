{
    "name": "baurzhanatinov/baurpdf",
    "description": "Beautiful HTML → PDF in pure PHP: modern CSS (flex, grid), tables, native charts, TOC, bookmarks, Cyrillic fonts, presentations. Zero system dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": ["pdf", "html2pdf", "html-to-pdf", "charts", "yii2", "mpdf", "report", "invoice"],
    "authors": [
        { "name": "Baurzhan Atinov", "email": "baurzhanatinov@gmail.com", "role": "Developer" }
    ],
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "ext-dom": "*"
    },
    "suggest": {
        "ext-gd": "GIF/WebP/BMP, interlaced and 16-bit PNG images, imageDpi() downscaling"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": { "psr-4": { "BaurPDF\\": "src/" } },
    "autoload-dev": { "psr-4": { "BaurPDF\\Tests\\": "tests/" } },
    "bin": ["bin/baurpdf"],
    "scripts": { "test": "phpunit" },
    "minimum-stability": "stable"
}
